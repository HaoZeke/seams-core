# Bulk TIP4P/2005 liquid at ${temp} K and 1 atm, oxygens written at the end.
# TIP4P/2005: Abascal and Vega, J. Chem. Phys. 123, 234505 (2005).
# epsilon_O = 0.1852 kcal/mol, sigma_O = 3.1589 A, q_H = 0.5564,
# q_M = -1.1128 placed by the pair style, d_OM = 0.1546 A,
# r_OH = 0.9572 A, angle 104.52 degrees. The step is 2 fs and Shake
# holds the geometry. The Lennard-Jones tail correction stands in for
# the long-range dispersion of the original parametrisation.

variable seed index 2005
variable temp index 300.0
variable nmelt index 10000
variable nequil index 50000

units real
atom_style full
boundary p p p
atom_modify map array

read_data data.tip4p

bond_style harmonic
bond_coeff 1 450.0 0.9572
angle_style harmonic
angle_coeff 1 55.0 104.52
special_bonds lj/coul 0.0 0.0 0.0
reset_atoms image all

pair_style lj/cut/tip4p/long 1 2 1 1 0.1546 10.0
pair_modify mix arithmetic tail yes
kspace_style pppm/tip4p 1.0e-4
pair_coeff 1 1 0.1852 3.1589
pair_coeff 2 2 0.0 1.0
pair_coeff 1 2 0.0 1.0

neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
timestep 2.0
thermo 1000
thermo_style custom step temp pe press density

# The harmonic bonds clear grid overlaps before Shake takes over.
minimize 1.0e-3 1.0e-4 100 1000
reset_timestep 0
fix shake all shake 0.0001 20 0 b 1 a 1
velocity all create ${temp} ${seed} mom yes rot yes dist gaussian
fix melt all nvt temp ${temp} ${temp} 200.0
run ${nmelt}
unfix melt
fix bath all npt temp ${temp} ${temp} 200.0 iso 1.0 1.0 2000.0
run ${nequil}

group oxygen type 1
write_dump oxygen custom bulk.lammpstrj id type x y z modify sort id
