# Homogeneous mW nucleation at deep supercooling.
# n^3 molecules, number density 0.033 /A^3.
# The integrator step is 10 fs (units real). A short melt at 350 K
# is quenched to Tq. The velocity seed is 20261111.
# Dump frames are not stored in git. regenerate.py writes them outside
# the work tree and runs the census on the saved frames.

variable n index 46
variable nmelt index 2000
variable nquench index 8000
variable ndump index 2000
variable Tq index 180

units real
atom_style atomic
boundary p p p
atom_modify map array

variable rho equal 0.033
variable L equal (v_n*v_n*v_n/v_rho)^(1.0/3.0)
variable a equal v_L/v_n

lattice sc ${a}
region box block 0 ${n} 0 ${n} 0 ${n}
create_box 1 box
create_atoms 1 box

mass 1 18.015
pair_style sw
pair_coeff * * mW.sw mW
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes

timestep 10.0
thermo 500
velocity all create 350.0 20261111 mom yes rot yes dist gaussian
fix 1 all nvt temp 350.0 350.0 200.0
run ${nmelt}
unfix 1
fix 1 all nvt temp ${Tq} ${Tq} 200.0
dump 1 all custom ${ndump} quench.lammpstrj id type x y z
run ${nquench}
