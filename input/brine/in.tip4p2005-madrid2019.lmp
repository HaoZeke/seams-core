# TIP4P/2005 water and Madrid-2019 NaCl (scaled charges q = +/- 0.85).
# Zeron, Abascal and Vega, J. Chem. Phys. 151, 134504 (2019),
# doi:10.1063/1.5121392, Tables III and IV.
# sigma is tabulated in nm and written here in angstrom.
# epsilon is tabulated in kJ/mol and written here in kcal/mol
# (1 kcal = 4.184 kJ). Cross terms are the tabulated values, not
# Lorentz-Berthelot. The Joung-Cheatham deck is in.tip4p2005-jc.lmp.
#
#   pair          sigma (A)   epsilon (kcal/mol)   epsilon (kJ/mol)
#   Na-Na         2.21737     0.351853250        1.472356
#   Cl-Cl         4.69906     0.018384799        0.076923
#   Na-Cl         3.00512     0.343856119        1.438894
#   Na-Ow         2.60838     0.189624283        0.793388
#   Cl-Ow         4.23867     0.014814293        0.061983
#
# Water: epsilon_O = 0.1852 kcal/mol, sigma_O = 3.1589 A,
# q_H = 0.5564, q_M = -1.1128 on the oxygen (the pair style
# places the M site), d_OM = 0.1546 A, r_OH = 0.9572 A,
# angle = 104.52 degrees. Ion charges in the data file are +/- 0.85.

units real
atom_style full
boundary p p p

variable datafile index data.brine
variable nsteps index 0
variable temp index 270

read_data ${datafile}

pair_style lj/cut/tip4p/long 1 2 1 1 0.1546 10.0
pair_modify mix arithmetic
kspace_style pppm/tip4p 1.0e-4
pair_coeff 1 1 0.1852 3.1589
pair_coeff 2 2 0.0 1.0
pair_coeff 3 3 0.351853250 2.21737
pair_coeff 4 4 0.018384799 4.69906
pair_coeff 1 3 0.189624283 2.60838
pair_coeff 1 4 0.014814293 4.23867
pair_coeff 3 4 0.343856119 3.00512
pair_coeff 1 2 0.0 1.0
pair_coeff 2 3 0.0 1.0
pair_coeff 2 4 0.0 1.0

bond_style harmonic
bond_coeff 1 450.0 0.9572
angle_style harmonic
angle_coeff 1 55.0 104.52
special_bonds lj/coul 0.0 0.0 0.0

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
timestep 2.0
thermo 500

velocity all create ${temp} 12345 dist gaussian

fix rigid all shake 0.0001 20 0 b 1 a 1
minimize 1.0e-4 1.0e-6 20 200
run ${nsteps}
write_dump all custom dump.lammpstrj id mol type x y z
