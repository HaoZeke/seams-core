+/*! \internal \file
+ * \brief
+ * Implements the d-SEAMS mdp options.
+ *
+ * \author Rohit Goswami <rgoswami@ieee.org>
+ */
+#include "gmxpre.h"
+
+#include "dseamsoptions.h"
+
+#include "dseamsMDModule.h"
+
+#include "gromacs/mdtypes/imdpoptionprovider_helpers.h"
+#include "gromacs/options/basicoptions.h"
+#include "gromacs/options/optionsection.h"
+#include "gromacs/utility/keyvaluetreebuilder.h"
+#include "gromacs/utility/keyvaluetreetransform.h"
+#include "gromacs/utility/strconvert.h"
+
+namespace gmx
+{
+namespace
+{
+const std::string c_active = "active";
+const std::string c_group  = "input-group";
+const std::string c_nst    = "nstcalc";
+const std::string c_cut    = "cutoff";
+const std::string c_out    = "output";
+} // namespace
+
+void DseamsOptions::initMdpTransform(IKeyValueTreeTransformRules* rules)
+{
+    const auto stringIdentityTransform = [](std::string text) { return text; };
+    addMdpTransformFromString<bool>(rules, &fromStdString<bool>, DseamsModuleInfo::sc_name, c_active);
+    addMdpTransformFromString<std::string>(rules, stringIdentityTransform, DseamsModuleInfo::sc_name, c_group);
+    addMdpTransformFromString<int>(rules, &fromStdString<int>, DseamsModuleInfo::sc_name, c_nst);
+    addMdpTransformFromString<double>(rules, &fromStdString<double>, DseamsModuleInfo::sc_name, c_cut);
+    addMdpTransformFromString<std::string>(rules, stringIdentityTransform, DseamsModuleInfo::sc_name, c_out);
+}
+
+void DseamsOptions::initMdpOptions(IOptionsContainerWithSections* options)
+{
+    auto section = options->addSection(OptionSection("dseams"));
+    section.addOption(BooleanOption(c_active.c_str()).store(&params_.active_));
+    section.addOption(StringOption(c_group.c_str()).store(&params_.inputGroup_));
+    section.addOption(IntegerOption(c_nst.c_str()).store(&params_.nstcalc_));
+    section.addOption(DoubleOption(c_cut.c_str()).store(&params_.cutoff_));
+    section.addOption(StringOption(c_out.c_str()).store(&params_.output_));
+}
+
+void DseamsOptions::buildMdpOutput(KeyValueTreeObjectBuilder* builder) const
+{
+    addMdpOutputComment(builder, DseamsModuleInfo::sc_name, "empty-line", "");
+    addMdpOutputComment(builder, DseamsModuleInfo::sc_name, "module", "; d-SEAMS in-situ analysis");
+    addMdpOutputValue(builder, DseamsModuleInfo::sc_name, c_active, params_.active_);
+    if (params_.active_)
+    {
+        addMdpOutputValue<std::string>(builder, DseamsModuleInfo::sc_name, c_group, params_.inputGroup_);
+        addMdpOutputValue<int>(builder, DseamsModuleInfo::sc_name, c_nst, params_.nstcalc_);
+        addMdpOutputValue<double>(builder, DseamsModuleInfo::sc_name, c_cut, params_.cutoff_);
+        addMdpOutputValue<std::string>(builder, DseamsModuleInfo::sc_name, c_out, params_.output_);
+    }
+}
+} // namespace gmx
