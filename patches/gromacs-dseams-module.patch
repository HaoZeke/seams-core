+/*! \internal \file
+ * \brief
+ * Force provider that analyses positions and adds no force.
+ *
+ * \author Rohit Goswami <rgoswami@ieee.org>
+ * \ingroup module_applied_forces
+ */
+#ifndef GMX_APPLIED_FORCES_DSEAMSFORCEPROVIDER_H
+#define GMX_APPLIED_FORCES_DSEAMSFORCEPROVIDER_H
+
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "gromacs/mdtypes/iforceprovider.h"
+#include "gromacs/utility/arrayref.h"
+
+#include "dseamsoptions.h"
+
+struct seams_insitu_engine;
+
+namespace gmx
+{
+class DseamsForceProvider final : public IForceProvider
+{
+public:
+    explicit DseamsForceProvider(const DseamsParameters& parameters);
+    ~DseamsForceProvider();
+    void setGlobalAtomIndices(const std::optional<ArrayRef<const int>>& indices);
+    void calculateForces(const ForceProviderInput& input, ForceProviderOutput* output) override;
+
+private:
+    DseamsParameters          parameters_;
+    seams_insitu_engine*      engine_ = nullptr;
+    std::vector<int>          globalIndices_;
+};
+} // namespace gmx
