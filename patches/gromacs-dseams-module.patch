+# as published by the Free Software Foundation; either version 2.1
+# of the License, or (at your option) any later version.
+
+# Detect seams-core and expose it as the dseamsgmx interface.
+
+set(SEAMS_INCLUDE "" CACHE PATH "Directory that contains seams_insitu.h")
+set(SEAMS_LIBRARY "" CACHE FILEPATH "Path to libyodaLib")
+
+function(gmx_manage_dseams)
+    add_library(dseamsgmx INTERFACE)
+    if(NOT SEAMS_INCLUDE OR NOT EXISTS "${SEAMS_INCLUDE}/seams_insitu.h")
+        message(FATAL_ERROR "d-SEAMS needs -DSEAMS_INCLUDE pointing at seams_insitu.h")
+    endif()
+    if(NOT SEAMS_LIBRARY OR NOT EXISTS "${SEAMS_LIBRARY}")
+        message(FATAL_ERROR "d-SEAMS needs -DSEAMS_LIBRARY pointing at libyodaLib")
+    endif()
+    target_include_directories(dseamsgmx INTERFACE "${SEAMS_INCLUDE}")
+    target_link_libraries(dseamsgmx INTERFACE "${SEAMS_LIBRARY}")
+    get_filename_component(_seams_libdir "${SEAMS_LIBRARY}" DIRECTORY)
+    set_property(TARGET dseamsgmx PROPERTY INTERFACE_LINK_DIRECTORIES "${_seams_libdir}")
+    message(STATUS "d-SEAMS module will link ${SEAMS_LIBRARY}")
+endfunction()
+
+gmx_manage_dseams()
