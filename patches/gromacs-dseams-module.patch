+/*! \internal \file
+ * \brief
+ * Gathers positions and runs the d-SEAMS census. No force is added.
+ *
+ * \author Rohit Goswami <rgoswami@ieee.org>
+ */
+#include "gmxpre.h"
+
+#include "dseamsforceprovider.h"
+
+#include <mpi.h>
+
+#include <vector>
+
+#include "gromacs/utility/vectypes.h"
+#include "gromacs/utility/mpicomm.h"
+
+#include <seams_insitu.h>
+
+namespace gmx
+{
+DseamsForceProvider::DseamsForceProvider(const DseamsParameters& parameters) :
+    parameters_(parameters)
+{
+    seams_insitu_options opt;
+    seams_insitu_options_default(&opt);
+    opt.cutoff            = parameters_.cutoff_;
+    opt.cadence.every     = 1;
+    opt.debug_dump        = 0;
+    engine_               = seams_insitu_create(&opt);
+    if (engine_ != nullptr)
+    {
+        seams_insitu_open_record(engine_, parameters_.output_.c_str());
+    }
+}
+
+DseamsForceProvider::~DseamsForceProvider()
+{
+    seams_insitu_destroy(engine_);
+    engine_ = nullptr;
+}
+
+void DseamsForceProvider::setGlobalAtomIndices(const std::optional<ArrayRef<const int>>& indices)
+{
+    globalIndices_.clear();
+    if (indices.has_value())
+    {
+        globalIndices_.assign(indices->begin(), indices->end());
+    }
+}
+
+void DseamsForceProvider::calculateForces(const ForceProviderInput& input, ForceProviderOutput*)
+{
+    if (engine_ == nullptr)
+    {
+        return;
+    }
+    if (parameters_.nstcalc_ > 1 && (input.step_ % parameters_.nstcalc_) != 0)
+    {
+        return;
+    }
+    const int nlocal = input.homenr_;
+    std::vector<int>    localIndex(static_cast<size_t>(nlocal));
+    std::vector<double> localXyz(static_cast<size_t>(nlocal) * 3);
+    for (int i = 0; i < nlocal; ++i)
+    {
+        const int global = globalIndices_.empty() ? i : globalIndices_[static_cast<size_t>(i)];
+        localIndex[static_cast<size_t>(i)] = global;
+        localXyz[static_cast<size_t>(3 * i)]     = input.x_[i][XX];
+        localXyz[static_cast<size_t>(3 * i + 1)] = input.x_[i][YY];
+        localXyz[static_cast<size_t>(3 * i + 2)] = input.x_[i][ZZ];
+    }
+    const int nprocs = input.mpiComm_.size();
+    std::vector<double> allXyz;
+    std::vector<int>    allIndex;
+    int                 total = nlocal;
+    if (nprocs == 1)
+    {
+        allXyz   = localXyz;
+        allIndex = localIndex;
+    }
+    else
+    {
+        std::vector<int> counts(static_cast<size_t>(nprocs));
+        MPI_Allgather(&nlocal, 1, MPI_INT, counts.data(), 1, MPI_INT, input.mpiComm_.comm());
+        std::vector<int> displs(static_cast<size_t>(nprocs));
+        std::vector<int> xcounts(static_cast<size_t>(nprocs));
+        std::vector<int> xdispls(static_cast<size_t>(nprocs));
+        total = 0;
+        for (int rank = 0; rank < nprocs; ++rank)
+        {
+            displs[static_cast<size_t>(rank)]  = total;
+            xdispls[static_cast<size_t>(rank)] = total * 3;
+            xcounts[static_cast<size_t>(rank)] = counts[static_cast<size_t>(rank)] * 3;
+            total += counts[static_cast<size_t>(rank)];
+        }
+        allIndex.resize(static_cast<size_t>(total));
+        allXyz.resize(static_cast<size_t>(total) * 3);
+        int    ipad = 0;
+        double xpad = 0.0;
+        MPI_Gatherv(nlocal > 0 ? localIndex.data() : &ipad,
+                    nlocal,
+                    MPI_INT,
+                    allIndex.data(),
+                    counts.data(),
+                    displs.data(),
+                    MPI_INT,
+                    0,
+                    input.mpiComm_.comm());
+        MPI_Gatherv(nlocal > 0 ? localXyz.data() : &xpad,
+                    nlocal * 3,
+                    MPI_DOUBLE,
+                    allXyz.data(),
+                    xcounts.data(),
+                    xdispls.data(),
+                    MPI_DOUBLE,
+                    0,
+                    input.mpiComm_.comm());
+    }
+    if (!input.mpiComm_.isMainRank())
+    {
+        return;
+    }
+    std::vector<double> xyz(static_cast<size_t>(total) * 3, 0.0);
+    std::vector<int>    types(static_cast<size_t>(total), 1);
+    std::vector<int>    ids(static_cast<size_t>(total));
+    for (int i = 0; i < total; ++i)
+    {
+        ids[static_cast<size_t>(i)] = i + 1;
+        const int global = allIndex[static_cast<size_t>(i)];
+        if (global < 0 || global >= total)
+        {
+            continue;
+        }
+        xyz[static_cast<size_t>(3 * global)]     = allXyz[static_cast<size_t>(3 * i)];
+        xyz[static_cast<size_t>(3 * global + 1)] = allXyz[static_cast<size_t>(3 * i + 1)];
+        xyz[static_cast<size_t>(3 * global + 2)] = allXyz[static_cast<size_t>(3 * i + 2)];
+    }
+    double rows[9] = { input.box_[0][0], input.box_[0][1], input.box_[0][2],
+                       input.box_[1][0], input.box_[1][1], input.box_[1][2],
+                       input.box_[2][0], input.box_[2][1], input.box_[2][2] };
+    double xlo = 0, ylo = 0, zlo = 0, lx = 0, ly = 0, lz = 0, xy = 0, xz = 0, yz = 0;
+    seams_insitu_box_from_rows(rows, &xlo, &ylo, &zlo, &lx, &ly, &lz, &xy, &xz, &yz);
+    seams_insitu_frame frame{};
+    frame.step        = static_cast<int>(input.step_);
+    frame.n           = total;
+    frame.xyz         = xyz.data();
+    frame.types       = types.data();
+    frame.ids         = ids.data();
+    frame.xlo         = xlo * 10.0;
+    frame.ylo         = ylo * 10.0;
+    frame.zlo         = zlo * 10.0;
+    frame.lx          = lx * 10.0;
+    frame.ly          = ly * 10.0;
+    frame.lz          = lz * 10.0;
+    frame.xy          = xy * 10.0;
+    frame.xz          = xz * 10.0;
+    frame.yz          = yz * 10.0;
+    frame.gathered    = 1;
+    frame.coord_scale = 10.0;
+    frame.rank        = 0;
+    frame.nranks      = nprocs;
+    seams_insitu_observe(engine_, &frame, nullptr);
+}
+} // namespace gmx
