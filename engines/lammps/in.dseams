# Cubic ice, metal units (Angstrom). Forces are cleared so the cell does not melt.
# fix ext is the in-run hook: the library callback calls the C API each step.
units metal
atom_style atomic
boundary p p p
read_data ice.data
mass 1 16.0
pair_style lj/cut 8.0
pair_coeff * * 0.1 2.75
velocity all set 0.0 0.0 0.0
fix freeze all setforce 0.0 0.0 0.0
fix ext all external pf/callback 1 1
thermo 1
timestep 0.001
run 3
