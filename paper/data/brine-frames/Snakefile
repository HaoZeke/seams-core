# Labelled 230 K brine frames, the per-replica tables and the figure.
# Restarts and frames stay out of git. config.yaml points at a local copy
# of the Hugging Face dataset d-SEAMS/brine-front-230K: data/restarts is
# read, data/frames receives a copy of each labelled xyz.
#
# brine_dataset mirrors the dataset at hf_revision into `dataset`.
# brine_run runs the campaign deck for each tag in config `runs` and
# writes its landing restarts into the same layout. brine_frame labels a
# restart; the outputs are
# paper/data/brine-frames/out/T230_m{pairs}_r{replica}_{t0,t1,t2,tend}.xyz.
# brine_sha256sums rewrites the dataset's SHA256SUMS over every file.
# brine_replicas writes the per-replica table and the replica ranges from
# the frames hf_revision lists; both CSVs are in git. brine_front_pdf
# builds the figure. Frames and restarts reach the dataset by upload, not
# by git; a new revision is a new hf_revision here.
#
#   snakemake -s paper/data/brine-frames/Snakefile -n paper/data/brine-frames/out/T230_m0_r0_t0.xyz
#   snakemake -s paper/data/brine-frames/Snakefile --cores 8 brine_runs
#   snakemake -s paper/data/brine-frames/Snakefile -j1 paper/data/brine-frames/replicas.csv
#   paper/tex/repro/brine_front.sh

from pathlib import Path

_RULES = Path(workflow.basedir)
_REPO = _RULES.parents[2]

configfile: str(_RULES / "config.yaml")

workdir: str(_REPO)

DATASET = config["dataset"]
RESTARTS = config.get("restarts", f"{DATASET}/data/restarts")
FRAMES = config.get("frames", f"{DATASET}/data/frames")
HF_REVISION = config["hf_revision"]
HF_MANIFEST = f"{DATASET}.{HF_REVISION}.txt"
RUNS = config["runs"]
WORK = config["work"]

FRAME_STEP = {"t0": 0, "t1": 830000, "t2": 1670000, "tend": 2500000}
RUN_FILES = [f"step-{step}.restart" for step in FRAME_STEP.values()] + ["end.restart"]


wildcard_constraints:
    T="230|240|245",
    pairs="0|10|20|40",
    replica="[0-9]+",
    name="t0|t1|t2|tend",
    run="|".join(RUNS),


def _restart(wildcards):
    step = FRAME_STEP[wildcards.name]
    return f"{RESTARTS}/T{wildcards.T}_m{wildcards.pairs}_r{wildcards.replica}/step-{step}.restart"


def _run_frames(where, temperatures=None):
    return [
        f"{where}/{run}_{name}.xyz"
        for run in RUNS
        if temperatures is None or run.split("_")[0][1:] in temperatures
        for name in FRAME_STEP
    ]


rule brine_frames:
    input:
        expand(
            "paper/data/brine-frames/out/T230_m{pairs}_r0_{name}.xyz",
            pairs=["0", "20", "40"],
            name=["t0", "t1", "t2", "tend"],
        ),


rule brine_dataset:
    input:
        script="paper/data/brine-frames/replicas.py",
    output:
        HF_MANIFEST,
    params:
        python=config["python"],
        hf=config["hf_dataset"],
    shell:
        "{params.python} paper/data/brine-frames/replicas.py fetch "
        "--dest {DATASET} --dataset {params.hf} --revision {HF_REVISION} --manifest {output}"


# One loading and replica of the campaign deck: melt at 400 K, quench, 5 ns
# at the run temperature T{T} of the tag.
# Ion sites use numpy seed {replica}; the velocity seed is {replica}3.
rule brine_run:
    input:
        manifest=ancient(HF_MANIFEST),
        deck="paper/data/brine-frames/deck/in.brine.lmp",
        system="paper/data/brine-frames/deck/brine_system.py",
    output:
        [f"{RESTARTS}/{{run}}/{name}" for name in RUN_FILES],
    threads: lambda wildcards: int(RUNS[wildcards.run])
    params:
        python=config["python"],
        lmp=config["lmp"],
        genice=config["genice"],
        timeout=config["lmp_timeout"],
        pairs=lambda wildcards: wildcards.run.split("_m")[1].split("_")[0],
        replica=lambda wildcards: wildcards.run.split("_r")[1],
        temperature=lambda wildcards: wildcards.run.split("_")[0][1:],
    log:
        f"{WORK}/{{run}}.log",
    shell:
        "{params.python} paper/data/brine-frames/regenerate.py run-one "
        "--work {WORK} --pairs {params.pairs} --replica {params.replica} --threads {threads} "
        "--temperature {params.temperature} --timeout {params.timeout} --restarts {RESTARTS} --lmp {params.lmp} --genice {params.genice} "
        "> {log} 2>&1"


rule brine_runs:
    input:
        _run_frames(FRAMES),


rule brine_frame:
    input:
        restart=_restart,
        deck="paper/data/brine-frames/deck/in.resume.lmp",
        script="paper/data/brine-frames/regenerate.py",
    output:
        out="paper/data/brine-frames/out/T{T}_m{pairs}_r{replica}_{name}.xyz",
        published=FRAMES + "/T{T}_m{pairs}_r{replica}_{name}.xyz",
    params:
        step=lambda wildcards: FRAME_STEP[wildcards.name],
        python=config["python"],
        lmp=config["lmp"],
        seams=config["seams"],
        lib=config["lib"],
    shell:
        "{params.python} paper/data/brine-frames/regenerate.py frame "
        "--restart {input.restart} --out {output.out} --publish {output.published} "
        "--step {params.step} --lmp {params.lmp} --seams {params.seams} --lib {params.lib}"


# The dataset's own checksum file, in the dataset's format: every file but
# SHA256SUMS and .gitattributes, sorted by path.
rule brine_sha256sums:
    input:
        manifest=HF_MANIFEST,
        frames=_run_frames(FRAMES),
        restarts=[f"{RESTARTS}/{run}/{name}" for run in RUNS for name in RUN_FILES],
        script="paper/data/brine-frames/replicas.py",
    output:
        f"{DATASET}/SHA256SUMS",
    params:
        python=config["python"],
    shell:
        "{params.python} paper/data/brine-frames/replicas.py sums --dataset {DATASET}"


# One row per replica x loading x frame of hf_revision; a frame the
# revision lacks is a row with status not_in_dataset. with_runs=true also
# reads the brine_run frames the revision lacks, marked source local.
WITH_RUNS = bool(config.get("with_runs", False))
LOCAL = [Path(f).name for f in _run_frames(FRAMES, ["230"])] if WITH_RUNS else []
WARM_LOCAL = [Path(f).name for f in _run_frames(FRAMES, ["240", "245"])] if WITH_RUNS else []


rule brine_replicas:
    input:
        manifest=HF_MANIFEST,
        frames=[f"{FRAMES}/{name}" for name in LOCAL],
        script="paper/data/brine-frames/replicas.py",
    output:
        table="paper/data/brine-frames/replicas.csv",
        span="paper/data/brine-frames/replicas_range.csv",
    params:
        python=config["python"],
        seams=config["seams"],
        local=" ".join(LOCAL),
    shell:
        "{params.python} paper/data/brine-frames/replicas.py table "
        "--frames {FRAMES} --seams {params.seams} --manifest {input.manifest} "
        "--local {params.local} --csv {output.table} && "
        "{params.python} paper/data/brine-frames/replicas.py range "
        "--csv {output.table} --out {output.span}"


rule brine_front_pdf:
    input:
        manifest=HF_MANIFEST,
        replicas="paper/data/brine-frames/replicas.csv",
        script="paper/data/brine-frames/render_front.py",
    output:
        "paper/tex/figures/brine_front.pdf",
    params:
        python=config["render_python"],
        t0=f"{FRAMES}/T230_m20_r0_t0.xyz",
        tend=f"{FRAMES}/T230_m20_r0_tend.xyz",
    shell:
        "{params.python} paper/data/brine-frames/render_front.py "
        "--xyz {params.t0} {params.tend} --replicas {input.replicas} --pdf {output}"


# Replica r0 at 240 K and 245 K, 0, 10, 20 and 40 pairs: the same table code
# and columns as brine_replicas, on the frames of the warm brine_run tags.
rule brine_warm:
    input:
        manifest=HF_MANIFEST,
        frames=[f"{FRAMES}/{name}" for name in WARM_LOCAL],
        script="paper/data/brine-frames/replicas.py",
    output:
        "paper/data/brine-frames/warm.csv",
    params:
        python=config["python"],
        seams=config["seams"],
        local=" ".join(WARM_LOCAL),
    shell:
        "{params.python} paper/data/brine-frames/replicas.py table "
        "--frames {FRAMES} --seams {params.seams} --manifest {input.manifest} "
        "--temperatures 240 245 --replicas r0 --pairs 0 10 20 40 "
        "--local {params.local} --csv {output}"
